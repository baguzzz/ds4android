<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <FrameLayout
        android:id="@+id/gamepadArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- D-PAD -->
        <Button android:id="@+id/dpadUp" android:text="▲"
            android:layout_width="50dp" android:layout_height="50dp" android:padding="0dp" android:textSize="16sp"
            android:backgroundTint="#333333" android:textColor="#FFFFFF" android:layout_marginLeft="150dp" android:layout_marginTop="100dp"/>
        <Button android:id="@+id/dpadDown" android:text="▼"
            android:layout_width="50dp" android:layout_height="50dp" android:padding="0dp" android:textSize="16sp"
            android:backgroundTint="#333333" android:textColor="#FFFFFF" android:layout_marginLeft="150dp" android:layout_marginTop="200dp"/>
        <Button android:id="@+id/dpadLeft" android:text="◀"
            android:layout_width="50dp" android:layout_height="50dp" android:padding="0dp" android:textSize="16sp"
            android:backgroundTint="#333333" android:textColor="#FFFFFF" android:layout_marginLeft="100dp" android:layout_marginTop="150dp"/>
        <Button android:id="@+id/dpadRight" android:text="▶"
            android:layout_width="50dp" android:layout_height="50dp" android:padding="0dp" android:textSize="16sp"
            android:backgroundTint="#333333" android:textColor="#FFFFFF" android:layout_marginLeft="200dp" android:layout_marginTop="150dp"/>

        <!-- FACE BUTTONS -->
        <Button android:id="@+id/btnY" android:text="Y"
            android:layout_width="55dp" android:layout_height="55dp" android:padding="0dp" android:textSize="16sp" android:textStyle="bold"
            android:backgroundTint="#FFC107" android:textColor="#000000" android:layout_marginLeft="700dp" android:layout_marginTop="80dp"/>
        <Button android:id="@+id/btnB" android:text="B"
            android:layout_width="55dp" android:layout_height="55dp" android:padding="0dp" android:textSize="16sp" android:textStyle="bold"
            android:backgroundTint="#F44336" android:textColor="#FFFFFF" android:layout_marginLeft="760dp" android:layout_marginTop="140dp"/>
        <Button android:id="@+id/btnA" android:text="A"
            android:layout_width="55dp" android:layout_height="55dp" android:padding="0dp" android:textSize="16sp" android:textStyle="bold"
            android:backgroundTint="#4CAF50" android:textColor="#FFFFFF" android:layout_marginLeft="700dp" android:layout_marginTop="200dp"/>
        <Button android:id="@+id/btnX" android:text="X"
            android:layout_width="55dp" android:layout_height="55dp" android:padding="0dp" android:textSize="16sp" android:textStyle="bold"
            android:backgroundTint="#2196F3" android:textColor="#FFFFFF" android:layout_marginLeft="640dp" android:layout_marginTop="140dp"/>

        <!-- SHOULDER BUTTONS -->
        <Button android:id="@+id/btnL1" android:text="L1"
            android:layout_width="60dp" android:layout_height="40dp" android:padding="0dp"
            android:backgroundTint="#333333" android:textColor="#CCCCCC" android:layout_marginLeft="50dp" android:layout_marginTop="20dp"/>
        <Button android:id="@+id/btnL2" android:text="L2"
            android:layout_width="60dp" android:layout_height="40dp" android:padding="0dp"
            android:backgroundTint="#333333" android:textColor="#CCCCCC" android:layout_marginLeft="120dp" android:layout_marginTop="20dp"/>
        <Button android:id="@+id/btnR1" android:text="R1"
            android:layout_width="60dp" android:layout_height="40dp" android:padding="0dp"
            android:backgroundTint="#333333" android:textColor="#CCCCCC" android:layout_marginLeft="800dp" android:layout_marginTop="20dp"/>
        <Button android:id="@+id/btnR2" android:text="R2"
            android:layout_width="60dp" android:layout_height="40dp" android:padding="0dp"
            android:backgroundTint="#333333" android:textColor="#CCCCCC" android:layout_marginLeft="730dp" android:layout_marginTop="20dp"/>

        <!-- CENTER BUTTONS -->
        <Button android:id="@+id/btnShare" android:text="Share"
            android:layout_width="60dp" android:layout_height="40dp" android:padding="0dp" android:textSize="10sp"
            android:backgroundTint="#333333" android:textColor="#CCCCCC" android:layout_marginLeft="350dp" android:layout_marginTop="20dp"/>
        <Button android:id="@+id/btnPS" android:text="PS"
            android:layout_width="50dp" android:layout_height="40dp" android:padding="0dp"
            android:backgroundTint="#4A148C" android:textColor="#FFFFFF" android:layout_marginLeft="430dp" android:layout_marginTop="20dp"/>
        <Button android:id="@+id/btnOptions" android:text="Options"
            android:layout_width="70dp" android:layout_height="40dp" android:padding="0dp" android:textSize="10sp"
            android:backgroundTint="#333333" android:textColor="#CCCCCC" android:layout_marginLeft="490dp" android:layout_marginTop="20dp"/>

        <!-- ANALOG STICKS -->
        <com.example.ds4remote.JoystickView
            android:id="@+id/leftStick"
            android:layout_width="150dp" android:layout_height="150dp"
            android:layout_marginLeft="150dp" android:layout_marginTop="250dp"/>

        <com.example.ds4remote.JoystickView
            android:id="@+id/rightStick"
            android:layout_width="150dp" android:layout_height="150dp"
            android:layout_marginLeft="600dp" android:layout_marginTop="250dp"/>

        <!-- L3 / R3 / TOUCHPAD -->
        <Button android:id="@+id/btnL3" android:text="L3"
            android:layout_width="50dp" android:layout_height="35dp" android:padding="0dp" android:textSize="10sp"
            android:backgroundTint="#444444" android:textColor="#FFFFFF" android:layout_marginLeft="350dp" android:layout_marginTop="350dp"/>
        <Button android:id="@+id/btnTouchpad" android:text="Touchpad"
            android:layout_width="100dp" android:layout_height="35dp" android:padding="0dp" android:textSize="10sp"
            android:backgroundTint="#444444" android:textColor="#FFFFFF" android:layout_marginLeft="410dp" android:layout_marginTop="350dp"/>
        <Button android:id="@+id/btnR3" android:text="R3"
            android:layout_width="50dp" android:layout_height="35dp" android:padding="0dp" android:textSize="10sp"
            android:backgroundTint="#444444" android:textColor="#FFFFFF" android:layout_marginLeft="520dp" android:layout_marginTop="350dp"/>
    </FrameLayout>

    <!-- TOP BAR (Koneksi & Tombol Edit) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#DD1E1E1E"
        android:gravity="center_vertical"
        android:layout_alignParentTop="true">

        <TextView android:id="@+id/status" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textColor="#90CAF9" android:textSize="12sp" android:text="Belum terhubung"/>

        <EditText android:id="@+id/ipInput" android:layout_width="110dp" android:layout_height="36dp"
            android:hint="192.168.1.10" android:textColorHint="#666666" android:textColor="#FFFFFF"
            android:textSize="12sp" android:inputType="text" android:background="#2A2A2A" android:padding="8dp"/>

        <Button android:id="@+id/connectBtn" android:layout_width="wrap_content" android:layout_height="36dp"
            android:text="Connect" android:textSize="11sp" android:layout_marginStart="8dp"
            android:backgroundTint="#4CAF50" android:textColor="#FFFFFF"/>

        <Button android:id="@+id/editLayoutBtn" android:layout_width="wrap_content" android:layout_height="36dp"
            android:text="⚙️ Edit" android:textSize="11sp" android:layout_marginStart="8dp"
            android:backgroundTint="#FF9800" android:textColor="#000000"/>
            
        <Button android:id="@+id/resetLayoutBtn" android:layout_width="wrap_content" android:layout_height="36dp"
            android:text="🔄 Reset" android:textSize="11sp" android:layout_marginStart="8dp"
            android:backgroundTint="#F44336" android:textColor="#FFFFFF" android:visibility="gone"/>

        <Button android:id="@+id/exportLayoutBtn" android:layout_width="wrap_content" android:layout_height="36dp"
            android:text="📤 Export" android:textSize="11sp" android:layout_marginStart="8dp"
            android:backgroundTint="#2196F3" android:textColor="#FFFFFF" android:visibility="gone"/>

        <Button android:id="@+id/importLayoutBtn" android:layout_width="wrap_content" android:layout_height="36dp"
            android:text="📥 Import" android:textSize="11sp" android:layout_marginStart="8dp"
            android:backgroundTint="#9C27B0" android:textColor="#FFFFFF" android:visibility="gone"/>
    </LinearLayout>

</RelativeLayout>