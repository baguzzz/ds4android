<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- Area Gamepad (Tempat semua tombol & stik) -->
    <FrameLayout
        android:id="@+id/gamepadArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- D-PAD -->
        <Button android:id="@+id/dpadUp" android:text="▲"
            android:layout_width="50dp" android:layout_height="50dp" android:padding="0dp" android:textSize="16sp"
            android:backgroundTint="#333333" android:textColor="#FFFFFF" android:x="150dp" android:y="100dp"/>
        <Button android:id="@+id/dpadDown" android:text="▼"
            android:layout_width="50dp" android:layout_height="50dp" android:padding="0dp" android:textSize="16sp"
            android:backgroundTint="#333333" android:textColor="#FFFFFF" android:x="150dp" android:y="200dp"/>
        <Button android:id="@+id/dpadLeft" android:text="◀"
            android:layout_width="50dp" android:layout_height="50dp" android:padding="0dp" android:textSize="16sp"
            android:backgroundTint="#333333" android:textColor="#FFFFFF" android:x="100dp" android:y="150dp"/>
        <Button android:id="@+id/dpadRight" android:text="▶"
            android:layout_width="50dp" android:layout_height="50dp" android:padding="0dp" android:textSize="16sp"
            android:backgroundTint="#333333" android:textColor="#FFFFFF" android:x="200dp" android:y="150dp"/>
        <View android:id="@+id/dpadCenter"
            android:layout_width="50dp" android:layout_height="50dp" android:x="150dp" android:y="150dp"/>

        <!-- FACE BUTTONS -->
        <Button android:id="@+id/btnY" android:text="Y"
            android:layout_width="55dp" android:layout_height="55dp" android:padding="0dp" android:textSize="16sp" android:textStyle="bold"
            android:backgroundTint="#FFC107" android:textColor="#000000" android:x="900dp" android:y="80dp"/>
        <Button android:id="@+id/btnB" android:text="B"
            android:layout_width="55dp" android:layout_height="55dp" android:padding="0dp" android:textSize="16sp" android:textStyle="bold"
            android:backgroundTint="#F44336" android:textColor="#FFFFFF" android:x="960dp" android:y="140dp"/>
        <Button android:id="@+id/btnA" android:text="A"
            android:layout_width="55dp" android:layout_height="55dp" android:padding="0dp" android:textSize="16sp" android:textStyle="bold"
            android:backgroundTint="#4CAF50" android:textColor="#FFFFFF" android:x="900dp" android:y="200dp"/>
        <Button android:id="@+id/btnX" android:text="X"
            android:layout_width="55dp" android:layout_height="55dp" android:padding="0dp" android:textSize="16sp" android:textStyle="bold"
            android:backgroundTint="#2196F3" android:textColor="#FFFFFF" android:x="840dp" android:y="140dp"/>

        <!-- SHOULDER BUTTONS -->
        <Button android:id="@+id/btnL1" android:text="L1"
            android:layout_width="60dp" android:layout_height="40dp" android:padding="0dp"
            android:backgroundTint="#333333" android:textColor="#CCCCCC" android:x="50dp" android:y="20dp"/>
        <Button android:id="@+id/btnL2" android:text="L2"
            android:layout_width="60dp" android:layout_height="40dp" android:padding="0dp"
            android:backgroundTint="#333333" android:textColor="#CCCCCC" android:x="120dp" android:y="20dp"/>
        <Button android:id="@+id/btnR1" android:text="R1"
            android:layout_width="60dp" android:layout_height="40dp" android:padding="0dp"
            android:backgroundTint="#333333" android:textColor="#CCCCCC" android:x="1000dp" android:y="20dp"/>
        <Button android:id="@+id/btnR2" android:text="R2"
            android:layout_width="60dp" android:layout_height="40dp" android:padding="0dp"
            android:backgroundTint="#333333" android:textColor="#CCCCCC" android:x="930dp" android:y="20dp"/>

        <!-- CENTER BUTTONS -->
        <Button android:id="@+id/btnShare" android:text="Share"
            android:layout_width="60dp" android:layout_height="40dp" android:padding="0dp" android:textSize="10sp"
            android:backgroundTint="#333333" android:textColor="#CCCCCC" android:x="450dp" android:y="20dp"/>
        <Button android:id="@+id/btnPS" android:text="PS"
            android:layout_width="50dp" android:layout_height="40dp" android:padding="0dp"
            android:backgroundTint="#4A148C" android:textColor="#FFFFFF" android:x="530dp" android:y="20dp"/>
        <Button android:id="@+id/btnOptions" android:text="Options"
            android:layout_width="70dp" android:layout_height="40dp" android:padding="0dp" android:textSize="10sp"
            android:backgroundTint="#333333" android:textColor="#CCCCCC" android:x="590dp" android:y="20dp"/>

        <!-- ANALOG STICKS -->
        <com.example.ds4remote.JoystickView
            android:id="@+id/leftStick"
            android:layout_width="150dp" android:layout_height="150dp"
            android:x="200dp" android:y="300dp"/>

        <com.example.ds4remote.JoystickView
            android:id="@+id/rightStick"
            android:layout_width="150dp" android:layout_height="150dp"
            android:x="800dp" android:y="300dp"/>

        <!-- L3 / R3 / TOUCHPAD -->
        <Button android:id="@+id/btnL3" android:text="L3"
            android:layout_width="50dp" android:layout_height="35dp" android:padding="0dp" android:textSize="10sp"
            android:backgroundTint="#444444" android:textColor="#FFFFFF" android:x="450dp" android:y="380dp"/>
        <Button android:id="@+id/btnTouchpad" android:text="Touchpad"
            android:layout_width="100dp" android:layout_height="35dp" android:padding="0dp" android:textSize="10sp"
            android:backgroundTint="#444444" android:textColor="#FFFFFF" android:x="510dp" android:y="380dp"/>
        <Button android:id="@+id/btnR3" android:text="R3"
            android:layout_width="50dp" android:layout_height="35dp" android:padding="0dp" android:textSize="10sp"
            android:backgroundTint="#444444" android:textColor="#FFFFFF" android:x="620dp" android:y="380dp"/>

    </FrameLayout>

    <!-- TOP BAR (Koneksi & Tombol Edit) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#DD1E1E1E"
        android:gravity="center_vertical"
        android:layout_alignParentTop="true">

        <TextView
            android:id="@+id/status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#90CAF9"
            android:textSize="12sp"
            android:text="Belum terhubung"/>

        <EditText
            android:id="@+id/ipInput"
            android:layout_width="120dp"
            android:layout_height="36dp"
            android:hint="192.168.1.10"
            android:textColorHint="#666666"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:inputType="text"
            android:background="#2A2A2A"
            android:padding="8dp"/>

        <Button
            android:id="@+id/connectBtn"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Connect"
            android:textSize="11sp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"/>

        <!-- Tombol Baru untuk Mengedit Layout -->
        <Button
            android:id="@+id/editLayoutBtn"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="⚙️ Edit"
            android:textSize="11sp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#FF9800"
            android:textColor="#000000"/>
    </LinearLayout>

</RelativeLayout>